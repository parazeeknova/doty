{
  "name": "waybar-top",
  "layer": "top",
  "position": "top",
  "height": 20,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "custom/layout", "hyprland/window"],
  "modules-center": ["clock#date"],
  "modules-right": [
    "custom/voxtype",
    "custom/tray_toggle",
    "custom/tailscale",
    "network",
    "pulseaudio",
    "battery",
    "clock",
  ],
  "custom/layout": {
    "exec": "hyprctl layoutmode",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "signal": 6,
    "on-click": "hyprctl layoutmode toggle",
    "tooltip": true,
  },
  "custom/tailscale": {
    "exec": "/home/parazeeknova/.config/waybar/scripts/get_tailscale_status",
    "return-type": "json",
    "interval": 5,
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config network_popup",
    "tooltip": true
  },
  "custom/voxtype": {
    "exec": "/home/parazeeknova/.config/waybar/scripts/get_voxtype_status",
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },
  "custom/tray_toggle": {
    "format": "{}",
    "return-type": "json",
    "exec": "/home/parazeeknova/.config/waybar/scripts/tray_count",
    "signal": 5,
    "on-click": "quickshell -c tray_popup ipc call tray_popup close || env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config tray_popup",
    "tooltip": false,
  },
  "network": {
    "interval": 10,
    "format-wifi": "{essid} {icon}",
    "format-ethernet": "lan {icon}",
    "format-linked": "{icon}",
    "format-disconnected": "󰖪",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config network_popup",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "i",
      "2": "ii",
      "3": "iii",
      "4": "iv",
      "5": "v",
      "6": "vi",
      "7": "vii",
      "8": "viii",
      "9": "ix",
      "10": "x",
    },
  },
  "hyprland/window": {
    "format": "{title}",
    "tooltip": false,
    "max-length": 60,
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config workspace_popup",
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip": false,
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config sysmon_popup",
  },
  "clock#date": {
    "format": "{:%d %m %y}",
    "tooltip": false,
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config notif_popup",
  },
  "pulseaudio": {
    "format": "{volume} {icon}",
    "format-bluetooth": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "󰋎",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", "󰕾"],
    },
    "scroll-step": 1,
    "on-scroll-up": "/home/parazeeknova/.config/quickshell/osd/bin/osdctl volume up",
    "on-scroll-down": "/home/parazeeknova/.config/quickshell/osd/bin/osdctl volume down",
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config volume_popup",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip": false,
  },
  "battery": {
    "interval": 60,
    "format": "{capacity} {icon}",
    "format-charging": "{capacity} {icon}",
    "format-full": "",
    "format-plugged": "",
    "on-click": "env QS_LAYOUT_MODE=$(cat ~/.cache/hypr_layout_mode 2>/dev/null) quickshell --config battery_popup",
    "tooltip": false,
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "cava": {
    "framerate": 45,
    "autosens": 0,
    "sensitivity": 0.1,
    "bars": 10,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "hide_on_silence": true,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": true,
    "waves": false,
    "noise_reduction": 0.11,
    "input_delay": 1,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
  },
}
