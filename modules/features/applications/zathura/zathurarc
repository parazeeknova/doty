# Zathura configuration rendered by wabi switcher from matugen colors.
# Do not edit this file directly — edit zathurarc.template instead.

set default-fg "#ede0d4"
set default-bg "#18120b"

# Completion colors
set completion-fg "#ede0d4"
set completion-bg "#251f17"
set completion-group-fg "#f6bc6f"
set completion-group-bg "#251f17"
set completion-highlight-fg "#18120b"
set completion-highlight-bg "#f6bc6f"

# Input bar colors
set inputbar-fg "#ede0d4"
set inputbar-bg "#251f17"

# Notification colors
set notification-fg "#ede0d4"
set notification-bg "#251f17"
set notification-error-fg "#ffb4ab"
set notification-error-bg "#251f17"
set notification-warning-fg "#b9cda0"
set notification-warning-bg "#251f17"

# Tab colors
set tabbar-fg "#ede0d4"
set tabbar-bg "#251f17"
set tabbar-focus-fg "#ede0d4"
set tabbar-focus-bg "#f6bc6f"

# Status bar colors
set statusbar-fg "#ede0d4"
set statusbar-bg "#251f17"

# Highlight colors
set highlight-color "#dec2a2"
set highlight-active-color "#f6bc6f"

# Recolor options (for dark mode reading)
set recolor "true"
set recolor-keephue "true"
set recolor-lightcolor "#18120b"
set recolor-darkcolor "#ede0d4"
