# Zathura configuration rendered by wabi switcher from matugen colors.
# Do not edit this file directly — edit zathurarc.template instead.

set default-fg "#e9e2d4"
set default-bg "#16130b"

# Completion colors
set completion-fg "#e9e2d4"
set completion-bg "#221f17"
set completion-group-fg "#dcc66e"
set completion-group-bg "#221f17"
set completion-highlight-fg "#16130b"
set completion-highlight-bg "#dcc66e"

# Input bar colors
set inputbar-fg "#e9e2d4"
set inputbar-bg "#221f17"

# Notification colors
set notification-fg "#e9e2d4"
set notification-bg "#221f17"
set notification-error-fg "#ffb4ab"
set notification-error-bg "#221f17"
set notification-warning-fg "#aad0b2"
set notification-warning-bg "#221f17"

# Tab colors
set tabbar-fg "#e9e2d4"
set tabbar-bg "#221f17"
set tabbar-focus-fg "#e9e2d4"
set tabbar-focus-bg "#dcc66e"

# Status bar colors
set statusbar-fg "#e9e2d4"
set statusbar-bg "#221f17"

# Highlight colors
set highlight-color "#d2c6a1"
set highlight-active-color "#dcc66e"

# Recolor options (for dark mode reading)
set recolor "true"
set recolor-keephue "true"
set recolor-lightcolor "#16130b"
set recolor-darkcolor "#e9e2d4"
