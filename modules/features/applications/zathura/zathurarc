# Zathura configuration rendered by wabi switcher from matugen colors.
# Do not edit this file directly — edit zathurarc.template instead.

set default-fg "#efe0d6"
set default-bg "#19120c"

# Completion colors
set completion-fg "#efe0d6"
set completion-bg "#261e18"
set completion-group-fg "#ffb77b"
set completion-group-bg "#261e18"
set completion-highlight-fg "#19120c"
set completion-highlight-bg "#ffb77b"

# Input bar colors
set inputbar-fg "#efe0d6"
set inputbar-bg "#261e18"

# Notification colors
set notification-fg "#efe0d6"
set notification-bg "#261e18"
set notification-error-fg "#ffb4ab"
set notification-error-bg "#261e18"
set notification-warning-fg "#c4cb97"
set notification-warning-bg "#261e18"

# Tab colors
set tabbar-fg "#efe0d6"
set tabbar-bg "#261e18"
set tabbar-focus-fg "#efe0d6"
set tabbar-focus-bg "#ffb77b"

# Status bar colors
set statusbar-fg "#efe0d6"
set statusbar-bg "#261e18"

# Highlight colors
set highlight-color "#e3c0a5"
set highlight-active-color "#ffb77b"

# Recolor options (for dark mode reading)
set recolor "true"
set recolor-keephue "true"
set recolor-lightcolor "#19120c"
set recolor-darkcolor "#efe0d6"
