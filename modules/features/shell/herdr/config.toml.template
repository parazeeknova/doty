# Herdr configuration - auto-generated from wallpaper colors by wabi theme_switcher
# Do not edit config.toml directly — edit config.toml.template instead.

onboarding = false

[theme]
name = "catppuccin"

[theme.custom]
sidebar_bg = "{{bg_dark}}"
active_row_bg = "{{bg_light}}"
selection_bg = "{{bg_light}}"
surface_dim = "{{bg_dark}}"
panel_bg = "{{bg}}"
accent = "{{accent}}"
blue = "{{accent}}"
mauve = "{{accent}}"
red = "{{error}}"
green = "{{accent}}"
yellow = "{{tertiary}}"
peach = "{{secondary}}"

[ui]
accent = "{{accent}}"
pane_gaps = false
status_indicators = "symbols"

[terminal]
new_cwd = "follow"
shell_mode = "auto"

[keys]
prefix = "ctrl+b"

[[keys.command]]
key = "prefix+e"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer"
description = "Toggle file viewer on the right"

[[keys.command]]
key = "prefix+E"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer-tab"
description = "Open file viewer tab"

[ui.toast]
delivery = "system"

[experimental]
kitty_graphics = true
