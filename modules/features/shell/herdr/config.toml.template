# Herdr configuration - auto-generated from wallpaper colors by wabi theme_switcher
# Do not edit config.toml directly — edit config.toml.template instead.

onboarding = false

[theme]
name = "catppuccin"

[theme.custom]
sidebar_bg = "{{bg_dark}}"
active_row_bg = "{{bg_light}}"
selection_bg = "{{bg_light}}"
surface_dim = "{{bg_dark}}"
panel_bg = "{{bg}}"
accent = "{{accent}}"
blue = "{{accent}}"
mauve = "{{accent}}"
red = "{{error}}"
green = "{{accent}}"
yellow = "{{tertiary}}"
peach = "{{secondary}}"

[ui]
accent = "{{accent}}"
pane_gaps = false
pane_borders = false
pane_outer_borders = false
status_indicators = "symbols"

[terminal]
new_cwd = "follow"
shell_mode = "auto"

[keys]
prefix = "ctrl+b"

[[keys.command]]
key = "prefix+p"
type = "plugin_action"
command = "allmight-ai.herdr-pet.open"
description = "Toggle Herdr Pet"

[ui.toast]
delivery = "herdr"

[ui.toast.herdr]
position = "top-right"

[ui.toast.clipboard]
enabled = true
position = "top-right"

[experimental]
kitty_graphics = true
