#!/usr/bin/env python3
"""Game shader daemon for Hyprland.

Automatically applies a vibrance/color-grading screen shader when Genshin Impact
is active, and turns it off when switching away or when the game exits.
"""

import atexit
import json
import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

SHADER_PATH = Path.home() / ".config/hypr/shaders/vibrance.glsl"
STATE_ON = None  # None = unknown initial state, True = on, False = off


def set_shader(enable: bool) -> None:
    global STATE_ON
    if STATE_ON is enable:
        return

    shader_arg = f'"{SHADER_PATH}"' if enable and SHADER_PATH.is_file() else '""'
    cmd = ["hyprctl", "eval", f"hl.config({{ decoration = {{ screen_shader = {shader_arg} }} }})"]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        STATE_ON = enable
    except Exception:
        pass


def is_game(data: dict) -> bool:
    if not data:
        return False

    title = data.get("title", "") or ""
    init_title = data.get("initialTitle", "") or ""
    klass = data.get("class", "") or ""
    init_class = data.get("initialClass", "") or ""
    xdg_tag = data.get("xdgTag", "") or ""

    t = f"{title} {init_title}".lower()
    c = f"{klass} {init_class}".lower()

    if "genshin impact" in t or "原神" in t or t.startswith("genshin"):
        return True
    if "genshinimpact" in c or "genshin" in c:
        return True
    if ("steam_proton" in c or "proton" in xdg_tag or "wine" in c) and ("genshin" in t or "原神" in t):
        return True

    return False


def get_active_window() -> dict:
    try:
        out = subprocess.check_output(["hyprctl", "activewindow", "-j"], timeout=1)
        data = json.loads(out)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def update_shader_state() -> None:
    win = get_active_window()
    if not win:
        # Avoid flickering during transient desktop switches; wait briefly and check once more
        time.sleep(0.1)
        win = get_active_window()

    if win and is_game(win):
        set_shader(True)
    else:
        set_shader(False)


def get_socket_path() -> Path | None:
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        try:
            out = subprocess.check_output(["hyprctl", "instances", "-j"], timeout=1)
            instances = json.loads(out)
            if instances and isinstance(instances, list):
                sig = instances[0].get("instance")
        except Exception:
            pass

    if not sig:
        return None

    uid = os.getuid()
    candidates = [
        Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}")) / "hypr" / sig / ".socket2.sock",
        Path(f"/run/user/{uid}/hypr/{sig}/.socket2.sock"),
        Path(f"/tmp/hypr/{sig}/.socket2.sock"),
    ]
    for p in candidates:
        if p.is_socket():
            return p
    return None


def cleanup() -> None:
    set_shader(False)


def handle_exit(signum, frame) -> None:
    cleanup()
    sys.exit(0)


def main() -> None:
    signal.signal(signal.SIGINT, handle_exit)
    signal.signal(signal.SIGTERM, handle_exit)
    signal.signal(signal.SIGHUP, handle_exit)
    atexit.register(cleanup)

    # Initial check
    update_shader_state()

    # Main event loop with auto-reconnect
    while True:
        sock_path = get_socket_path()
        if not sock_path:
            time.sleep(2)
            continue

        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.connect(str(sock_path))
                # Re-sync state once connected
                update_shader_state()
                sock_file = client.makefile("r", encoding="utf-8", errors="replace")
                for line in sock_file:
                    if not line:
                        break
                    event = line.strip().split(">>")[0]
                    if event == "configreloaded":
                        STATE_ON = None
                        update_shader_state()
                    elif event in (
                        "activewindow",
                        "activewindowv2",
                        "closewindow",
                        "workspace",
                        "workspacev2",
                        "focusedmon",
                    ):
                        update_shader_state()
        except (socket.error, OSError):
            time.sleep(2)


if __name__ == "__main__":
    main()
